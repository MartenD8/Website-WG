# Event Calendar – Environment Variables
# Copy this file to .env.local and adjust values before first start.

# Secret for signing JWT session cookies (min. 32 characters)
# Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Initial admin credentials (used when the database is first created)
# To reset later on the server: npm run admin:reset
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

# Session lifetime in hours (admin)
SESSION_MAX_AGE_HOURS=24

# Shared visitor login for the whole website (login page: /login)
# Optional – defaults are used when unset.
# Quotes are required: an unquoted "#" would start a comment and yield an empty value.
SITE_USERNAME=HasselWG
SITE_PASSWORD="#RettetXoro"

# Visitor session lifetime in days
GUEST_SESSION_MAX_AGE_DAYS=30

# Optional: force Secure cookies (true/false). Default: auto via X-Forwarded-Proto
# COOKIE_SECURE=true

# Optional: calendar year for 25.09.–18.10. (must be NEXT_PUBLIC_ for client UI)
# NEXT_PUBLIC_CALENDAR_YEAR=2026

# Public site URL (used in metadata / production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
